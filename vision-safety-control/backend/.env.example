# 이 파일을 .env 로 복사해서 값을 바꿔 쓰세요. (.env 는 git 에 올리지 않음)
# 값에는 영문 · 숫자 · 기호만 쓰세요. 아래 명령으로 임의의 키를 만들 수 있습니다:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DATABASE_URL=mysql+pymysql://safety:CHANGE_ME@localhost:3306/safety_control?charset=utf8mb4
JWT_SECRET=CHANGE_ME_long_random_string
JWT_EXPIRE_MINUTES=480
INGEST_API_KEY=CHANGE_ME_ingest_key

# YOLO 탐지 영상 (pip install -r requirements-yolo.txt). 안 쓰면 YOLO_ENABLED=false
# YOLO_MODEL=yolo11n.pt
# 사람 · 안전모 · 조끼 · 장비를 함께 학습한 모델 하나로 (backend/site6c.pt 를 넣어 두면 처음 켤 때 변환). 이때 YOLO_PPE_MODEL 은 비운다
# YOLO_MODEL=site6c_openvino_model
# YOLO_CONF=0.35
# YOLO_DEVICE=
# STREAM_FPS=8
# STREAM_MAX_WIDTH=960
# ROI 이벤트: 보는 사람이 없어도 판정할 구역이 있는 카메라는 계속 탐지. 노트북이 버거우면 false (화면을 볼 때만 판정)
# EVENT_WATCH=true
# 추적: bytetrack (기본) | botsort (카메라 흔들림 보정, TC 카메라처럼 움직이는 화면에 나음. CPU 더 씀). 비우면 추적 · 장비 근접 판정 안 함
# TRACKER=bytetrack
# 장비 근접: 장비로 볼 클래스 · 거리(m) · 그 안에 머문 시간(초)
# PROXIMITY_CLASSES=truck,excavator,forklift
# PROXIMITY_M=3.0
# PROXIMITY_HOLD_SEC=1.0
# 안전모 · 조끼 미착용: tools/train/ppe_finetune.ipynb 로 학습한 모델. 비우면 판정 안 함
# YOLO_PPE_MODEL=ppe_openvino_model
# PPE_PART_CONF=0.30
# PPE_WINDOW_SEC=3
# PPE 모델은 탐지 이만큼에 한 번만 (1 이면 매번)
# PPE_EVERY=2
# PPE_MIN_PERSON_PX=100
# 신호수 미배치: 빨간 계열 조끼 = 신호수 (PPE 모델 필요). 이 장비가 보이는 동안 신호수가 N초 넘게 없으면 경보
# SIGNAL_CLASSES=truck,excavator,forklift
# SIGNAL_HOLD_SEC=10
# SIGNAL_MIN_PERSON_PX=60
# 빨강 쪽 · 노랑 쪽 경계 색상 (OpenCV H 0~179). 주황 조끼를 일반 작업자로 보려면 낮추고(예: 10), 신호수로 보려면 높인다
# SIGNAL_HUE_SPLIT=15

# 웹 푸시 알림 (휴대폰 · PC). 서명 키는 처음 쓸 때 storage/vapid_private.pem 에 만들어진다 (지우면 모든 기기가 다시 켜야 함)
# PUSH_ENABLED=true
# 푸시 서비스(구글 · 애플)가 문제 있을 때 연락할 곳. 실제 메일 주소나 사이트 주소로 바꾼다
# PUSH_SUBJECT=mailto:admin@example.com
